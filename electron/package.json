{
  "name": "rollfilm-desktop",
  "version": "0.1.59",
  "description": "Rollfilm — native desktop photo library & film-look editor",
  "main": "main.js",
  "author": "Pasqual Kreher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run copy:renderer && electron .",
    "predev": "node scripts/dev-clean.js",
    "dev": "concurrently -k -n renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "clean:dev": "node scripts/dev-clean.js",
    "dev:renderer": "cd ../frontend && npm run dev",
    "dev:electron": "wait-on -t 120000 -i 500 http-get://127.0.0.1:5173 && cross-env PM_DEV=1 electron . --pm-dev-electron",
    "copy:renderer": "node -e \"const fs=require('fs');fs.rmSync('renderer',{recursive:true,force:true});fs.cpSync('../frontend/dist','renderer',{recursive:true})\"",
    "build:renderer": "cd ../frontend && npm run build && cd ../electron && npm run copy:renderer",
    "build:backend": "cd ../backend && sh build_backend.sh",
    "pack": "npm run build:renderer && npm run build:backend && electron-builder --dir",
    "dist": "npm run build:renderer && npm run build:backend && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pasqualkreher.rollfilm",
    "productName": "Rollfilm",
    "publish": [
      {
        "provider": "github",
        "owner": "pasqualkreher",
        "repo": "rollfilm"
      }
    ],
    "files": [
      "main.js",
      "networkVolume.js",
      "preload.js",
      "updater.js",
      "splash.html",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "directories": {
      "output": "dist-app"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "identity": null,
      "gatekeeperAssess": false,
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
