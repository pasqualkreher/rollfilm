# exiftool config: Rollfilm's own XMP namespace, for the edit it keeps in a
# photo's .xmp sidecar (services/sidecar.py). One tag, XMP-rollfilm:Develop,
# holds the whole edit as JSON - the PATCH /images/{id}/edits payload - so
# another copy of Rollfilm reading the sidecar gets the edit back exactly.
# Other programs keep what is theirs and pass this namespace by.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        rollfilm => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::rollfilm',
            },
        },
    },
);

%Image::ExifTool::UserDefined::rollfilm = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-rollfilm', 2 => 'Image' },
    NAMESPACE => { 'rollfilm' => 'https://rollfilm.app/ns/1.0/' },
    WRITABLE => 'string',
    Develop => { },
);

1;
