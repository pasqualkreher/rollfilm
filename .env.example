# Photo Manager - environment configuration
#
# Copy this file to `.env` (in this same directory, next to docker-compose.yml)
# and adjust as needed:  cp .env.example .env
#
# Docker Compose reads `.env` automatically and substitutes these values into
# docker-compose.yml. Every variable has a sensible default there, so an empty
# or missing `.env` still works - only set the ones you want to change.
#
# NOTE: The Immich server URL and API key are NOT configured here - they are
# entered in the app under Settings -> Immich integration and stored per-user.

# ---- Ports (host side) ----
# Where the API and web UI are exposed on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Frontend ----
# URL the browser uses to reach the backend API. If you change BACKEND_PORT or
# run the backend on another host, update this to match.
VITE_API_BASE_URL=http://localhost:8000

# ---- Host data locations ----
# Folders on YOUR machine that get mounted into the backend container. This is
# where your actual photo library, database, thumbnails, staging area, and the
# downloaded CLIP model are persisted. Point these at wherever you want the data
# to live (e.g. an external drive: /Volumes/Photos/library).
HOST_LIBRARY_PATH=./data/library
HOST_DB_PATH=./data/db
HOST_STAGING_PATH=./data/staging
HOST_THUMBNAIL_PATH=./data/thumbnails
HOST_MODEL_CACHE_PATH=./data/models

# ---- Container data paths ----
# Paths INSIDE the backend container. These match the mount targets in
# docker-compose.yml - leave them as-is unless you also change those mounts.
LIBRARY_ROOT=/data/library
DB_PATH=/data/db/library.db
IMPORT_STAGING_ROOT=/data/staging
THUMBNAIL_CACHE_ROOT=/data/thumbnails
MODEL_CACHE_ROOT=/data/models

# ---- Auth ----
# "none" = single local user (default). "multiuser" is reserved for a future
# hosted mode and not yet implemented.
AUTH_MODE=none

# ---- CLIP model (semantic search) ----
# The open_clip model used for image/text embeddings. The defaults are a good
# balance of quality and size; change only if you know you want another model.
CLIP_MODEL_NAME=ViT-B-32
CLIP_MODEL_PRETRAINED=laion2b_s34b_b79k

# Disable the Hugging Face Xet transfer backend (avoids download issues in some
# environments). Set to 0 to re-enable it.
HF_HUB_DISABLE_XET=1

# ---- Import tuning (optional) ----
# Max Hamming distance between perceptual hashes for two photos to be flagged as
# near-duplicates during import. Lower = stricter (fewer matches). Backend
# default is 5. Not wired into docker-compose by default; add it under the
# backend service's `environment:` if you want to override it.
# DUPLICATE_PHASH_HAMMING_THRESHOLD=5
